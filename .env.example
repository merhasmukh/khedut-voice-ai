# Google Gemini API Key (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Vector Store Selection ────────────────────────────────────────────────────
# Set to 'qdrant' (default, local Docker) or 'pinecone' (cloud, no Docker)
VECTOR_STORE=qdrant

# ── Qdrant Configuration (used when VECTOR_STORE=qdrant) ─────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=khedut_knowledge

# ── Pinecone Configuration (used when VECTOR_STORE=pinecone) ─────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=khedut-knowledge
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=khedut

# ── WhatsApp Notification Service ───────────────────────────────────────────
WHATSAPP_API_KEY=your_whatsapp_api_key_here
WHATSAPP_SERVICE_URL=https://web.gujaratvidyapith.org/services/whatsapp_service/api_whatsapp.php
WHATSAPP_DEFAULT_TEMPLATE=logincred
WHATSAPP_DEFAULT_LANGUAGE=en

# ── Voice Audio Thresholds (RMS) ──────────────────────────────────────────────
# NOISE_GATE_THRESHOLD: Set to 6000 for open farm/wind, or 1500 for quiet lab
NOISE_GATE_THRESHOLD=1500
# INTERRUPT_RMS_THRESHOLD: Loudness required to interrupt long audio playback
INTERRUPT_RMS_THRESHOLD=3000
