[Unit]
Description=Khedut Voice AI - Raspberry Pi Standalone Agent
Documentation=https://github.com/merhasmukh/khedut-voice-ai
After=network-online.target bluetooth.target sound.target pulseaudio.service
Wants=network-online.target bluetooth.target pulseaudio.service

[Service]
Type=simple
User=pi
Group=pi

# Project path on Raspberry Pi
WorkingDirectory=/home/pi/hasmukh/khedut-voice-ai

# Wrapper script: waits for internet, checks API key, activates venv, starts agent
ExecStart=/home/pi/hasmukh/khedut-voice-ai/start.sh

# Always restart — even on clean exit (handles dropped network, etc.)
Restart=always
RestartSec=10

# Disable crash-loop limit — never permanently stop
StartLimitIntervalSec=0

# Allow up to 2 minutes for internet wait inside start.sh
TimeoutStartSec=120

# Logging — view with: journalctl -u khedut-voice-pi -f
StandardOutput=journal
StandardError=journal

# Keep Python output unbuffered so logs appear in real-time
Environment=PYTHONUNBUFFERED=1
Environment=USER=pi
Environment=HOME=/home/pi
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native

# Audio device access
SupplementaryGroups=audio bluetooth pulse pulse-access

[Install]
WantedBy=multi-user.target
